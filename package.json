{
  "name": "qa-spine",
  "version": "0.1.0",
  "description": "MCP server exposing QA-lifecycle agents over a traceability spine: requirement -> findings -> tests -> results -> release verdict, with provenance for every AI-produced artifact.",
  "license": "MIT",
  "type": "module",
  "bin": { "qa-spine": "dist/server.js" },
  "files": ["dist", "rubrics", "README.md"],
  "engines": { "node": ">=22.5" },
  "scripts": {
    "test": "node --test 'tests/*.test.ts'",
    "prepublishOnly": "npm test && npm run build",
    "build": "tsc && node -e \"require('fs').cpSync('src/inspector/ui','dist/inspector/ui',{recursive:true})\"",
    "start": "node src/server.ts",
    "inspect": "node src/server.ts inspect"
  },
  "keywords": ["mcp", "qa", "testing", "traceability", "model-context-protocol"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
